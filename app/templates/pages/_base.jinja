{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>NZART Voting {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/icon.png">

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    
    <script src="/static/js/utils.js"></script>
    <script src="/static/js/htmx.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    {# <link rel="stylesheet" href="/static/css/styles.css"> #}
    <link rel="stylesheet" href="/static/css/output.css">
    
</head>

<body>

    <header>
        <a href="/">
            NZART Voting
        </a>
        <nav>
        {% if session.logged_in %}
            {% if session.user.role=="admin" %}
                <a href="/admin/users">Administrate Users</a>
            {% endif %}
            {% if session.user.role=="officer" %}
                <a href="/officer/election">Admin Election</a>
            {% endif %}

            <p>{{session.user.name}} {{session.user.callsign}}</p>
        
        
        
        <a href="/logout">Logout</a>
        
        {% else %}
        <a href="/login">Login</a>
        {% endif%}

        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

</body>

<script>
    lucide.createIcons();

    document.body.addEventListener('htmx:afterSwap', function(evt) {
        lucide.createIcons();
    });
</script>

</html>

